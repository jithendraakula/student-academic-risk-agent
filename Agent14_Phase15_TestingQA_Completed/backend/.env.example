# Agent 14 backend environment template
ENVIRONMENT=development
DATABASE_URL=sqlite:///backend/agent14.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
ENABLE_DOCS=true

# External AI (optional)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=25
# Keep false unless the institution has approved sending identifiable student data to the external provider.
AI_INCLUDE_STUDENT_IDENTIFIERS=false
AI_ALLOWED_EXTERNAL_DATA=false

# Notifications (optional)
NOTIFICATIONS_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@vignan.ac.in
