DATABASE_URL=sqlite:///./agent14.db
JWT_SECRET=changeme-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Mentor AI Copilot (server-side only; never expose API keys in frontend)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=25

# Phase 12 notifications
NOTIFICATIONS_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@vignan.ac.in
NOTIFICATION_HOD_PRIORITY_THRESHOLD=80
NOTIFICATION_DEAN_PRIORITY_THRESHOLD=90

# Phase 14 — security hardening
ENVIRONMENT=development
TRUSTED_HOSTS=localhost,127.0.0.1
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
MAX_REQUEST_BYTES=2097152
ENABLE_DOCS=true
